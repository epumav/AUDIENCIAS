# ============================================================
# CALENDARIO GMAIL - CONFIGURACION VERSION 4
# ============================================================
# IMPORTANTE:
# - Este archivo es solo un ejemplo.
# - Copialo como .env y completa tus datos reales.
# - NUNCA subas el archivo .env a GitHub.
# - NO escribas aqui las contraseñas de Gmail.
# ============================================================

# Credenciales OAuth de Google Cloud
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET

# ------------------------------------------------------------
# CUENTA GMAIL 1
# Escribe el correo. El refresh token se obtiene con:
# npm run setup -- 1
# ------------------------------------------------------------
CORREO_1=correo1@gmail.com
REFRESH_TOKEN_1=

# ------------------------------------------------------------
# CUENTA GMAIL 2
# Escribe el correo. El refresh token se obtiene con:
# npm run setup -- 2
# ------------------------------------------------------------
CORREO_2=correo2@gmail.com
REFRESH_TOKEN_2=

# Configuracion general
TIMEZONE=America/Lima
PORT=3000

# URL exacta del sitio GitHub Pages publicado.
# Ejemplo: https://usuario.github.io
# Si el proyecto esta en una ruta, usa el origen solamente,
# por ejemplo: https://usuario.github.io
FRONTEND_ORIGIN=https://TU-USUARIO.github.io
